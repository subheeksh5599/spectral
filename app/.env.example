# App configuration — every value is required; the server refuses to start without them.
# No defaults live in the code, so the app can never silently talk to the wrong chain.

# local chain (anvil) — matches the workflow run in docs/RECEIPTS.md
CHAIN_ID=31337
CHAIN_NAME=Anvil local
RPC_URL=http://127.0.0.1:8545
EXPLORER_URL=http://127.0.0.1:8545
NATIVE_SYMBOL=ETH
FAUCET_URL=http://127.0.0.1:8545
VENUE_ADDRESS=0x057ef64E23666F000b34aE31332854aCBd1c8544
PORT=5173

# testnet 1952 — swap these in for the public build
# CHAIN_ID=1952
# CHAIN_NAME=X Layer testnet
# RPC_URL=https://testrpc.xlayer.tech/terigon
# EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer-test
# NATIVE_SYMBOL=OKB
# FAUCET_URL=https://web3.okx.com/xlayer/faucet
# VENUE_ADDRESS=<set after the testnet deploy>

# the second market (ERC-20 denominated): leave empty if not deployed
TOKEN_MARKET_ADDRESS=
TOKEN_ASSET_ADDRESS=
TOKEN_SYMBOL=tTSLA

# Spectral — environment (testnet only, no secrets committed)
# Copy to .env and fill. Every value is REQUIRED; there are no defaults in code.

XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech/terigon
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech

# Deploy scripts read DEPLOYER_KEY. On 1952 set it to your testnet-only key
# (funded from the faucet, 0.2 OKB/day). Locally any funded chain account works.
DEPLOYER_KEY=

# actor keys for the local end-to-end run (Foundry's public anvil accounts)
BUYER_KEY=
EXECUTOR_KEY=
TAKER_KEY=

# kept separately for the testnet deploy
DEPLOYER_PRIVATE_KEY=

# optional: personal OKX key for server-side market data without a wallet session
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# public config served to the client (never hardcode these in the app)
VITE_CHAIN_ID=1952
VITE_EXPLORER=https://www.okx.com/web3/explorer/xlayer-test
VITE_FAUCET=https://web3.okx.com/xlayer/faucet

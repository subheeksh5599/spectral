# Obligo — environment (testnet only, no secrets committed)
# Copy to .env and fill. Every value is REQUIRED; there are no defaults in code.

XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech/terigon
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech

# deployer key: testnet-only wallet, funded from the faucet (0.2 OKB/day)
# NEVER commit this file. .env is gitignored.
DEPLOYER_PRIVATE_KEY=

# optional: personal OKX key for server-side market data without a wallet session
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# public config served to the client (never hardcode these in the app)
VITE_CHAIN_ID=1952
VITE_EXPLORER=https://www.okx.com/web3/explorer/xlayer-test
VITE_FAUCET=https://web3.okx.com/xlayer/faucet

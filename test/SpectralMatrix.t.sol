    }
    /// @dev each account's credit is its own and is paid exactly once
    function test_isolation_claim_is_per_account() public {
        uint256 id = _closed();
        address[3] memory who = [buyer, executor, taker];
        for (uint256 k; k < 3; k++) {
            uint256 owed = o.credits(who[k]);
            if (owed == 0) {
                vm.prank(who[k]);
                vm.expectRevert(Spectral.NothingToClaim.selector);
                o.claim();
            } else {
                uint256 before = who[k].balance;
                vm.prank(who[k]);
                o.claim();
                assertEq(who[k].balance - before, owed);
                assertEq(o.credits(who[k]), 0);
            }
        }
    }
    /// @dev one party claiming leaves the other's credit reserved
    function test_isolation_partial_claim_leaves_others_intact() public {
        uint256 id = _closed();

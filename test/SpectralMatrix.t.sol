    // ---------- state construction, through the public API only ----------

    function _open() internal returns (uint256 id) {
        vm.prank(buyer);
        id = o.createJob{value: ESCROW}(executor, UNITS, PPU, block.timestamp + DAY);
    }

    function _stalled() internal returns (uint256 id) {
        id = _open();
        vm.prank(executor);
        o.declareStalled(id);
    }

    function _listed() internal returns (uint256 id) {
        id = _stalled();
        o.listObligation(id, block.timestamp + DAY);
    }

    function _taken() internal returns (uint256 id) {
        id = _listed();
        uint256 required = o.requiredBond(id);
        vm.prank(taker);
        o.takeObligation{value: required}(id);
        _assertTakerIsRecorded(id, taker);
    }

    /// @dev two units counted, then the executor quits and a taker posts the bond
    function _takenPartial() internal returns (uint256 id) {
        id = _open();
        vm.startPrank(executor);
        o.countUnit(id, 0, bytes32(uint256(1)));
        o.countUnit(id, 1, bytes32(uint256(2)));
        o.declareStalled(id);
        vm.stopPrank();
        o.listObligation(id, block.timestamp + DAY);
        uint256 required = o.requiredBond(id);
        vm.prank(taker);
        o.takeObligation{value: required}(id);
    }

    function _settled() internal returns (uint256 id) {
        id = _open();
        for (uint256 i; i < UNITS; i++) {
            vm.prank(executor);
            o.countUnit(id, i, bytes32(uint256(i) + 1));
        }
    }

    function _closed() internal returns (uint256 id) {
        id = _takenPartial();
        vm.warp(block.timestamp + DAY + 1);
        o.closeFailed(id);
    }


    function _openLate() internal returns (uint256 id) { id = _open(); vm.warp(block.timestamp + DAY + 1); }
    function _stalledLate() internal returns (uint256 id) { id = _stalled(); vm.warp(block.timestamp + DAY + 1); }
    function _listedLate() internal returns (uint256 id) { id = _listed(); vm.warp(block.timestamp + DAY + 1); }
    function _takenLate() internal returns (uint256 id) { id = _taken(); vm.warp(block.timestamp + DAY + 1); }
    function _takenPartialLate() internal returns (uint256 id) { id = _takenPartial(); vm.warp(block.timestamp + DAY + 1); }
    function _settledLate() internal returns (uint256 id) { id = _settled(); vm.warp(block.timestamp + DAY + 1); }
    function _closedLate() internal returns (uint256 id) { id = _closed(); vm.warp(block.timestamp + DAY + 1); }


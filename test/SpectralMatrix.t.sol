    /// @dev the taker deadline before does not close a failed takeover
    function test_takerdeadline_before_closes() public {
        uint256 id = _takenWithDeadline();
        uint256 takerDeadline = takerDeadlineOf(id);
        vm.warp(takerDeadlineOf(id) - 1);
        vm.expectRevert(Spectral.DeadlineNotReached.selector);
        o.closeFailed(id);
        _assertState(id, Spectral.State.Taken);
    }

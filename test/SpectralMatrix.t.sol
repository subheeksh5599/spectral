    // ================= I. fuzz =================

    /// @dev conservation over arbitrary workloads: sum of credits plus in-flight equals balance
    function testFuzz_matrix_conservation(uint96 escrowUnits, uint256 ppu, uint256 execUnits, uint256 takerUnits) public {
        uint256 units = bound(uint96(escrowUnits), 1, 4);
        ppu = bound(ppu, 0, 1 ether);
        uint256 esc = units * ppu;
        vm.deal(buyer, esc);
        vm.prank(buyer);
        uint256 id = o.createJob{value: esc}(executor, units, ppu, block.timestamp + DAY);

        uint256 e = bound(execUnits, 0, units);
        uint256 t = bound(takerUnits, 0, units - e);
        vm.startPrank(executor);
        for (uint256 i; i < e; i++) o.countUnit(id, i, bytes32(uint256(i) + 1));
        if (e < units) o.declareStalled(id);
        vm.stopPrank();
        if (e < units) {
            o.listObligation(id, block.timestamp + DAY);
            uint256 bond = o.requiredBond(id);
            vm.prank(taker);
            o.takeObligation{value: bond}(id);
            vm.startPrank(taker);
            for (uint256 i = e; i < e + t; i++) o.countUnit(id, i, bytes32(uint256(i) + 1));
            vm.stopPrank();
        }
        uint256 owed = o.credits(buyer) + o.credits(executor) + o.credits(taker);
        uint256 inFlight;
        if (o.stateOf(id) != Spectral.State.Settled) {
            inFlight = esc;
            if (o.stateOf(id) == Spectral.State.Taken) {
                (, , , , , , , , , , uint256 bondHeld, ) = o.jobs(id);
                inFlight += bondHeld;
            }
        }
        assertEq(address(o).balance, owed + inFlight, "conservation broken");
    }

    /// @dev the executor's credit is always exactly what it counted, at any price
    function testFuzz_matrix_executor_paid_for_counted_units(uint128 ppu, uint8 counted) public {
        uint256 price = bound(uint128(ppu), 0, 1 ether);
        uint256 n = bound(uint8(counted), 1, 6);
        uint256 esc = n * price;
        vm.deal(buyer, esc);
        vm.prank(buyer);
        uint256 id = o.createJob{value: esc}(executor, n, price, block.timestamp + DAY);
        vm.startPrank(executor);
        for (uint256 i; i < n; i++) o.countUnit(id, i, bytes32(uint256(i) + 1));
        vm.stopPrank();
        assertEq(o.credits(executor), n * price);
        assertEq(address(o).balance, n * price);
    }

    /// @dev the required bond is always exactly half the remaining escrow
    function testFuzz_matrix_bond_is_half_the_remainder(uint8 total, uint8 counted) public {
        uint256 units = bound(uint8(total), 2, 8);
        uint256 c = bound(uint8(counted), 0, units - 1);
        uint256 price = 1 ether;
        uint256 esc = units * price;
        vm.deal(buyer, esc);
        vm.prank(buyer);
        uint256 id = o.createJob{value: esc}(executor, units, price, block.timestamp + DAY);
        vm.startPrank(executor);
        for (uint256 i; i < c; i++) o.countUnit(id, i, bytes32(uint256(i) + 1));
        o.declareStalled(id);
        vm.stopPrank();
        o.listObligation(id, block.timestamp + DAY);
        uint256 remaining = units - c;
        assertEq(o.remainingUnits(id), remaining);
        assertEq(o.requiredBond(id), (remaining * price) / 2);
    }

    /// @dev a job can never settle with units outstanding
    function testFuzz_matrix_no_settlement_with_units_outstanding(uint8 counted) public {
        uint256 n = 5;
        uint256 c = bound(uint8(counted), 0, n - 1);
        vm.prank(buyer);
        uint256 id = o.createJob{value: n * PPU}(executor, n, PPU, block.timestamp + DAY);
        vm.startPrank(executor);
        for (uint256 i; i < c; i++) o.countUnit(id, i, bytes32(uint256(i) + 1));
        vm.stopPrank();
        _assertState(id, Spectral.State.Open);
        assertEq(o.credits(executor), 0);
        assertEq(address(o).balance, n * PPU);
    }

    /// @dev no sequence of counts can make a party's credit exceed the escrow it is paid from
    function testFuzz_matrix_credits_never_exceed_escrow(uint8 n, uint8 c) public {
        uint256 units = bound(uint8(n), 1, 6);
        uint256 c1 = bound(uint8(c), 0, units);
        uint256 esc = units * PPU;
        vm.deal(buyer, esc);
        vm.prank(buyer);
        uint256 id = o.createJob{value: esc}(executor, units, PPU, block.timestamp + DAY);
        vm.startPrank(executor);
        for (uint256 i; i < c1; i++) o.countUnit(id, i, bytes32(uint256(i) + 1));
        vm.stopPrank();
        assertLe(o.credits(executor), esc);
        assertLe(o.credits(buyer) + o.credits(executor) + o.credits(taker), esc);
    }

    // ================= G. isolation =================

    /// @dev counting in one job cannot move another
    function test_isolation_two_jobs_are_separate() public {
        uint256 id = _open();
        vm.prank(buyer);
        uint256 id2 = o.createJob{value: ESCROW}(stranger, UNITS, PPU, block.timestamp + DAY);

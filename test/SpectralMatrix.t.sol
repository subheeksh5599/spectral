        vm.prank(taker);
        o.takeObligation{value: bond}(id);
        _assertTakerIsRecorded(id, taker);
        vm.startPrank(taker);
        for (uint256 i = UNITS - 8; i < UNITS; i++) o.countUnit(id, i, bytes32(uint256(i) + 1));
        vm.stopPrank();
        _assertState(id, Spectral.State.Settled);
        assertEq(o.credits(executor), 2 * PPU);
        assertEq(o.credits(taker), 8 * PPU + bond);
        assertEq(address(o).balance, o.credits(executor) + o.credits(taker));
    }

        o.countUnit(id, 0, bytes32(uint256(1)));
        assertEq(o.remainingUnits(id), UNITS - 1);
        assertEq(o.remainingUnits(id2), UNITS);
    }
    /// @dev settling one job leaves the other's escrow locked and still in the venue
    function test_isolation_settling_one_leaves_the_other_live() public {
        uint256 id = _open();
        vm.prank(buyer);
        uint256 id2 = o.createJob{value: ESCROW}(stranger, UNITS, PPU, block.timestamp + DAY);
        vm.startPrank(executor);
        for (uint256 i; i < UNITS; i++) o.countUnit(id, i, bytes32(uint256(i) + 1));
        vm.stopPrank();
        _assertState(id, Spectral.State.Settled);
        _assertState(id2, Spectral.State.Open);

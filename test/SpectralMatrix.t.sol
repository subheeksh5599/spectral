    // ================= C. bond boundary =================

    /// @dev exact bond accepted with 1 units remaining
    function test_bond_exact_1_units_remain() public {
        uint256 id = _partial1();
        uint256 required = o.requiredBond(id);
        vm.prank(taker);
        o.takeObligation{value: required}(id);
        _assertState(id, Spectral.State.Taken);
        (, , , , , , , , , , uint256 bond, ) = o.jobs(id);
        assertEq(bond, required);
    }
    /// @dev one wei short of the bond is refused with 1 units remaining
    function test_bond_one_wei_short_1_units_remain() public {
        uint256 id = _partial1();
        uint256 required = o.requiredBond(id);
        vm.prank(taker);
        vm.expectRevert(abi.encodeWithSelector(Spectral.BondTooSmall.selector, required));
        o.takeObligation{value: required - 1}(id);
    }
    /// @dev an overpaid bond is recorded in full with 1 units remaining
    function test_bond_overpay_1_units_remain() public {
        uint256 id = _partial1();
        uint256 required = o.requiredBond(id);
        vm.prank(taker);
        o.takeObligation{value: required + 1}(id);
        (, , , , , , , , , , uint256 bond, ) = o.jobs(id);
        assertEq(bond, required + 1);
    }
    /// @dev the bond is exactly half the remaining escrow with 1 units remaining
    function test_bond_formula_1_units_remain() public {
        uint256 id = _partial1();
        uint256 remaining_units = o.remainingUnits(id);
        assertEq(o.requiredBond(id), (remaining_units * PPU * 5000) / 10000);
    }

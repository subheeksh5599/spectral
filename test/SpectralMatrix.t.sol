    // ================= D. deadline boundary =================

    /// @dev the work deadline before: executor may stall
    function test_workdeadline_before_by_executor() public {
        uint256 id = _openWithDeadline();
        uint256 workDeadline = workDeadlineOf(id);
        vm.warp(workDeadline - 1);
        vm.prank(executor);
        o.declareStalled(id);
        _assertState(id, Spectral.State.Stalled);
    }
    /// @dev the work deadline before: stranger may not stall
    function test_workdeadline_before_by_stranger() public {
        uint256 id = _openWithDeadline();
        uint256 workDeadline = workDeadlineOf(id);
        vm.warp(workDeadline - 1);
        vm.prank(stranger);
        vm.expectRevert(Spectral.DeadlineNotReached.selector);
        o.declareStalled(id);
    }

    // ================= E2. payout and remainder exactness =================

    /// @dev after 1 units: nothing is owed yet and the remainder is exact
    function test_paid_exactly_for_1_units() public {
        uint256 id = _open();
        vm.startPrank(executor);
        for (uint256 i; i < 1; i++) o.countUnit(id, i, bytes32(uint256(i) + 1));
        vm.stopPrank();
        assertEq(o.credits(executor), 0);
        assertEq(o.remainingUnits(id), UNITS - 1);
    }
    /// @dev a split of 2 and 8 units pays each side for exactly what it counted
    function test_settled_for_1_units_pays_1_times_price() public {
        uint256 id = _partial8();
